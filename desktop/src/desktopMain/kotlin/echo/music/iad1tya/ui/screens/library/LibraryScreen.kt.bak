@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun LibraryScreen(
    database: MusicDatabase,
    playerEngine: DesktopPlaybackEngine,
    preferences: LocalPreferences,
    scope: CoroutineScope
) {
    var selectedTab by remember { mutableStateOf(0) }
    val tabs = listOf("Playlists", "Liked Songs", "Downloads", "Local Files")

    val favoriteSongs by database.favorites.collectAsState()

    Column(modifier = Modifier.fillMaxSize().padding(24.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
        Text("Your Library", style = MaterialTheme.typography.headlineMedium.copy(fontWeight = FontWeight.Bold, color = TextPrimary))
        TabRow(selectedTabIndex = selectedTab, containerColor = MaterialTheme.colorScheme.surfaceContainer, contentColor = ElectricCyan) {
            tabs.forEachIndexed { i, t ->
                Tab(selected = selectedTab == i, onClick = { selectedTab = i }, text = { Text(t) })
            }
        }
        when (selectedTab) {
            0 -> LibraryPlaceholder("Playlists", "Your playlists will appear here. Open a local audio file to start listening.")
            1 -> {
                if (favoriteSongs.isEmpty()) {
                    LibraryPlaceholder("Liked Songs", "Songs you like will be saved here.")
                } else {
                    LazyColumn(modifier = Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
                        items(favoriteSongs.size) { index ->
                            val track = favoriteSongs[index]
                            Row(
                                modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                Icon(Icons.Filled.Favorite, contentDescription = null, tint = AccentMagenta, modifier = Modifier.size(24.dp))
                                Text(track.title, style = MaterialTheme.typography.bodyMedium.copy(color = TextPrimary))
                                Spacer(Modifier.weight(1f))
                                TextButton(onClick = { scope.launch { playerEngine.loadAndPlay(track) } }) {
                                    Text("Play", color = ElectricCyan)
                                }
                                IconButton(onClick = { database.removeFavorite(track.id) }) {
                                    Icon(Icons.Filled.Close, contentDescription = "Remove", tint = TextSecondary)
                                }
                            }
                        }
                    }
                }
            }
            2 -> LibraryPlaceholder("Downloads", "Downloaded tracks for offline playback will appear here.")
            3 -> LocalFilesScreen(database, playerEngine, scope)
        }
    }
}

@Composable
fun LocalFilesScreen(database: MusicDatabase, playerEngine: DesktopPlaybackEngine, scope: CoroutineScope) {
    val localSongs by remember { mutableStateOf(database.getAllSongs()) }
    val localOnly = localSongs.filter { it.audioUrl != null && (it.audioUrl.startsWith("/") || it.audioUrl.startsWith("\\") || File(it.audioUrl).exists()) }

    Column(modifier = Modifier.fillMaxSize().padding(24.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
        Text("Local Files", style = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.Bold, color = TextPrimary))
        if (localOnly.isEmpty()) {
            LibraryPlaceholder("No Local Files", "Use the Open File button to add audio files to your library.")
        } else {
            LazyColumn(modifier = Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
                items(localOnly.size) { index ->
                    val track = localOnly[index]
                    Row(
                        modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(Icons.Filled.AudioFile, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(24.dp))
                        Text(track.title, style = MaterialTheme.typography.bodyMedium.copy(color = TextPrimary))
                        Spacer(Modifier.weight(1f))
                        TextButton(onClick = { scope.launch { playerEngine.loadAndPlay(track) } }) {
                            Text("Play", color = ElectricCyan)
                        }
                    }
                }
            }
        }
    }
}

@Composable
fun LibraryPlaceholder(title: String, subtitle: String) {
    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
        Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(8.dp)) {
            Icon(Icons.Filled.LibraryMusic, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(64.dp))
            Text(title, style = MaterialTheme.typography.titleLarge.copy(color = TextPrimary))
            Text(subtitle, style = MaterialTheme.typography.bodyMedium.copy(color = TextSecondary))
        }
    }
}

@Composable
fun LocalTrackRow(
    track: SongModel,
    index: Int,
    isPlaying: Boolean,
    onClick: () -> Unit,
    onMoreClick: () -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp, vertical = 8.dp)
            .clickable { onClick() }
            .pointerInput(Unit) { detectTapGestures(onDoubleTap = { onClick() }) }
            .background(MaterialTheme.colorScheme.surfaceContainerHigh, RoundedCornerShape(12.dp))
    ) {
        Text(
            "$index",
            style = MaterialTheme.typography.bodyMedium.copy(color = if (isPlaying) ElectricCyan else TextSecondary),
            modifier = Modifier.padding(start = 16.dp, end = 16.dp).width(40.dp)
        )

        Box(
            modifier = Modifier.size(48.dp).clip(RoundedCornerShape(8.dp)),
            contentAlignment = Alignment.Center
        ) {
            ArtworkImage(url = track.artworkUrl, contentDescription = track.title)
        }

        Column(modifier = Modifier.weight(1f).padding(horizontal = 16.dp), verticalArrangement = Arrangement.Center) {
            Text(track.title, style = MaterialTheme.typography.bodyLarge.copy(color = TextPrimary, fontWeight = if (isPlaying) FontWeight.Bold else FontWeight.Normal), maxLines = 1, overflow = TextOverflow.Ellipsis)
            Text(track.artist, style = MaterialTheme.typography.bodySmall.copy(color = TextSecondary), maxLines = 1, overflow = TextOverflow.Ellipsis)
        }

        Text(
            formatTime(track.durationMs),
            style = MaterialTheme.typography.bodySmall.copy(color = TextSecondary),
            modifier = Modifier.padding(end = 16.dp).width(60.dp)
        )

        IconButton(onClick = onMoreClick) {
            Icon(Icons.Filled.MoreVert, contentDescription = "More", tint = TextSecondary)
        }
    }
}

@Composable
fun AlbumGridCard(
    album: AlbumModel,
    onClick: () -> Unit
) {
    Card(
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerHigh),
        shape = RoundedCornerShape(16.dp),
        modifier = Modifier
            .widthIn(min = 180.dp, max = 220.dp)
            .clickable { onClick() }
    ) {
        Column(modifier = Modifier.padding(16.dp)) {
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .aspectRatio(1f)
                    .clip(RoundedCornerShape(12.dp))
                    .background(
                        Brush.linearGradient(listOf(ElectricCyan.copy(alpha = 0.6f), MaterialTheme.colorScheme.surfaceContainerHigh))
                    ),
                contentAlignment = Alignment.Center
            ) {
                Text(album.title.take(1).uppercase(), color = Color.White, fontSize = 48.sp, fontWeight = FontWeight.Bold)
            }
            Spacer(Modifier.height(12.dp))
            Text(album.title, fontWeight = FontWeight.Bold, color = TextPrimary, maxLines = 1, overflow = TextOverflow.Ellipsis)
            Text(album.artist, color = TextSecondary, fontSize = 12.sp, maxLines = 1, overflow = TextOverflow.Ellipsis)
            Text("${album.songCount} songs", style = MaterialTheme.typography.labelSmall.copy(color = TextSecondary))
        }
    }
}





