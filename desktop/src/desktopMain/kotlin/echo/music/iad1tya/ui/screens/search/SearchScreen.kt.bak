@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SearchScreen(
    innerTube: InnerTubeClient,
    playerEngine: DesktopPlaybackEngine,
    database: MusicDatabase,
    scope: CoroutineScope,
    initialQuery: String = "",
    onBackClick: () -> Unit = {}
) {
    var query by remember { mutableStateOf(initialQuery) }
    var results by remember { mutableStateOf(listOf<SongModel>()) }
    var isSearching by remember { mutableStateOf(false) }
    var selectedTab by remember { mutableStateOf(0) }

    val tabs = listOf("Songs", "Albums", "Artists", "Playlists")

    val scopeInner = rememberCoroutineScope()
    val searchFocus = remember { FocusRequester() }

    var isSearchingLocal by remember { mutableStateOf(false) }
    var localResults by remember { mutableStateOf(listOf<SongModel>()) }

    fun performSearch() {
        if (query.isBlank()) return
        isSearching = true
        scope.launch {
            try {
                val result = innerTube.search(query)
                results = result.songs
                isSearching = false
            } catch (e: Exception) {
                e.printStackTrace()
                isSearching = false
            }
        }
    }

    val searchBar = @Composable {
        Surface(
            color = MaterialTheme.colorScheme.surfaceContainer,
            modifier = Modifier.fillMaxWidth().height(64.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxSize().padding(horizontal = 16.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                IconButton(onClick = onBackClick) {
                    Icon(Icons.Filled.ArrowBack, contentDescription = "Back", tint = ElectricCyan)
                }
                OutlinedTextField(
                    value = query,
                    onValueChange = { query = it },
                    placeholder = { Text("Search songs, artists, albums, playlists...", color = TextSecondary) },
                    singleLine = true,
                    shape = RoundedCornerShape(24.dp),
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedContainerColor = VoidSlateCard,
                        unfocusedContainerColor = VoidSlateCard,
                        focusedBorderColor = ElectricCyan,
                        unfocusedBorderColor = Color.Transparent,
                        focusedTextColor = TextPrimary,
                        unfocusedTextColor = TextPrimary
                    ),
                    leadingIcon = { Icon(Icons.Filled.Search, contentDescription = null, tint = TextSecondary) },
                    modifier = Modifier
                        .weight(1f)
                        .height(48.dp)
                        .focusRequester(searchFocus)
                        .padding(end = 8.dp)
                )
                IconButton(onClick = { 
                    if (query.isNotBlank()) {
                        performSearch()
                    }
                }) {
                    Icon(Icons.Filled.Send, contentDescription = "Search", tint = ElectricCyan)
                }
            }
        }
    }

    // Local search
    LaunchedEffect(query) {
        if (query.isNotBlank()) {
            isSearchingLocal = true
            scope.launch {
                try {
                    val localSongs = database.getAllSongs().filter { it.title.contains(query, true) || it.artist.contains(query, true) }
                    localResults = localSongs
                    isSearchingLocal = false
                } catch (e: Exception) {
                    isSearchingLocal = false
                }
            }
        }
    }

    Surface(
        modifier = Modifier
            .fillMaxSize()
            .onKeyEvent { event ->
                if (event.type == KeyEventType.KeyDown && event.key == Key.Escape) {
                    onBackClick()
                    true
                } else false
            }
    ) {
        Column(Modifier.fillMaxSize()) {
            searchBar()

            // Tabs
            TabRow(
                selectedTabIndex = selectedTab,
                containerColor = MaterialTheme.colorScheme.surfaceContainer,
                contentColor = ElectricCyan,
                indicator = { tabPositions ->
                    TabRowDefaults.Indicator(
                        Modifier
                            .offset(x = tabPositions[selectedTab].left)
                            .width(tabPositions[selectedTab].width)
                            .height(3.dp)
                            .background(ElectricCyan)
                    )
                }
            ) {
                tabs.forEach { tab ->
                    Tab(selected = selectedTab == tabs.indexOf(tab), onClick = { selectedTab = tabs.indexOf(tab) }, text = { Text(tab) })
                }
            }

            // Content
            Box(Modifier.weight(1f).fillMaxHeight()) {
                when (selectedTab) {
                    0 -> SearchSongsContent(
                        results = results,
                        isSearching = isSearching,
                        localResults = localResults,
                        isSearchingLocal = isSearchingLocal,
                        playerEngine = playerEngine,
                        database = database,
                        scope = scope
                    )
                    1 -> SearchAlbumsContent()
                    2 -> SearchArtistsContent()
                    3 -> SearchPlaylistsContent()
                }
            }

            // Bottom player bar handled by main app
        }
    }
}

@Composable
fun SearchSongsContent(
    results: List<SongModel>,
    isSearching: Boolean,
    localResults: List<SongModel>,
    isSearchingLocal: Boolean,
    playerEngine: DesktopPlaybackEngine,
    database: MusicDatabase,
    scope: CoroutineScope
) {
    val scopeInner = rememberCoroutineScope()

    Column(Modifier.fillMaxSize().padding(24.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
        if (isSearching) {
            CircularProgressIndicator(Modifier.align(Alignment.CenterHorizontally))
        } else if (results.isEmpty() && localResults.isEmpty()) {
            Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(8.dp)) {
                    Icon(Icons.Filled.SearchOff, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(64.dp))
                    Text("No results found", style = MaterialTheme.typography.titleLarge.copy(color = TextPrimary))
                    Text("Try a different search term", style = MaterialTheme.typography.bodyMedium.copy(color = TextSecondary))
                }
            }
        } else {
            if (localResults.isNotEmpty()) {
                Text("Local Files", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold, color = ElectricCyan))
                LazyColumn(verticalArrangement = Arrangement.spacedBy(0.dp)) {
                    items(localResults.size) { index ->
                        val track = localResults[index]
                        AlbumTrackRow(
                            track = track,
                            index = index + 1,
                            isPlaying = false,
                            onClick = { scope.launch { playerEngine.loadAndPlay(track) } },
                            onMoreClick = { /* show menu */ }
                        )
                    }
                }
            }

            if (results.isNotEmpty()) {
                Text("YouTube Music Results", style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold, color = ElectricCyan))
                LazyColumn(verticalArrangement = Arrangement.spacedBy(0.dp)) {
                    items(results.size) { index ->
                        val track = results[index]
                        AlbumTrackRow(
                            track = track,
                            index = index + 1,
                            isPlaying = false,
                            onClick = { scopeInner.launch { playerEngine.loadAndPlay(track) } },
                            onMoreClick = { /* show menu */ }
                        )
                    }
                }
            }
        }
    }
}@Composable fun SearchAlbumsContent() {
    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
        Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(8.dp)) {
            Icon(Icons.Filled.Album, contentDescription = null, tint = TextSecondary, modifier = Modifier.size(64.dp))
            Text("Albums", style = MaterialTheme.typography.titleLarge.copy(color = TextPrimary))
            Text("Album search coming soon", style = MaterialTheme.typography.bodyMedium.copy(color = TextSecondary))
        }
    }
}

